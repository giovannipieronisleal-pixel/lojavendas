<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lojavendas.MainPage"
             BackgroundColor="#F6F5F0"
             Shell.NavBarIsVisible="False"
             SizeChanged="OnPageSizeChanged">
    <Grid RowDefinitions="*,Auto" Padding="24,16">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout x:Name="FormContainer"
                                 MaximumWidthRequest="480"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center"
                                 Padding="0,16"
                                 Spacing="28">
                <Label x:Name="TitleLabel"
                       Text="Acesso&#10;para funcionários."
                       FontFamily="Inter"
                       FontAttributes="Bold"
                       FontSize="40"
                       LineHeight="1.12"
                       CharacterSpacing="-0.02"
                       TextColor="#242B28"
                       LineBreakMode="WordWrap"
                       SemanticProperties.HeadingLevel="Level1" />

                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Login"
                               FontFamily="Inter"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#242B28" />
                        <Border MinimumHeightRequest="56"
                                Padding="14,4"
                                BackgroundColor="White"
                                Stroke="#D7DBD2"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8">
                            <Entry x:Name="LoginEntry"
                                   Placeholder="Digite seu login"
                                   FontFamily="Inter"
                                   FontSize="16"
                                   TextColor="#242B28"
                                   PlaceholderColor="#9A9E96"
                                   VerticalOptions="Center"
                                   ReturnType="Next"
                                   SemanticProperties.Description="Login" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Senha"
                               FontFamily="Inter"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#242B28" />
                        <Border MinimumHeightRequest="56"
                                Padding="14,4"
                                BackgroundColor="White"
                                Stroke="#D7DBD2"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center">
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="0"
                                       Placeholder="Digite sua senha"
                                       FontFamily="Inter"
                                       FontSize="16"
                                       TextColor="#242B28"
                                       PlaceholderColor="#9A9E96"
                                       IsPassword="True"
                                       VerticalOptions="Center"
                                       ReturnType="Go"
                                       Completed="OnPasswordCompleted"
                                       SemanticProperties.Description="Senha" />
                                <Button x:Name="PasswordVisibilityButton"
                                        Grid.Column="1"
                                        Text="Mostrar"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Padding="8,0"
                                        MinimumWidthRequest="60"
                                        FontFamily="Inter"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        TextColor="#293F35"
                                        Clicked="OnTogglePasswordVisibility"
                                        SemanticProperties.Description="Mostrar senha" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Grid HeightRequest="56" Margin="0,4,0,0">
                        <Button x:Name="AcessButton"
                                Text="Acessar"
                                BackgroundColor="#293F35"
                                TextColor="#F3F4E9"
                                FontFamily="Inter"
                                FontAttributes="Bold"
                                FontSize="16"
                                ContentLayout="Left,20"
                                BorderWidth="0"
                                CornerRadius="8"
                                Clicked="OnAccessClicked"
                                SemanticProperties.Description="Acessar"
                                SemanticProperties.Hint="Valida os campos de acesso" />
                        <Image Source="arrow_right.svg"
                               WidthRequest="20"
                               HeightRequest="20"
                               Margin="0,0,20,0"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="1"
                               Margin="0,8,0,4"
                               Spacing="6"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Idioma: Português do Brasil">
            <Image Source="globe.svg"
                   WidthRequest="14"
                   HeightRequest="14"
                   VerticalOptions="Center" />
            <Label Text="Português (BR)"
                   FontFamily="Inter"
                   FontSize="12"
                   TextColor="#727871"
                   VerticalTextAlignment="Center" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
