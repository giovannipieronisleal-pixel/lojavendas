<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lojavendas.MainPage"
             BackgroundColor="#F6F5F0"
             Shell.NavBarIsVisible="False"
             SizeChanged="OnPageSizeChanged">
    <Grid Padding="24"
          RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout x:Name="FormContainer"
                                 WidthRequest="520"
                                 MaximumWidthRequest="520"
                                 HorizontalOptions="Center"
                                 Spacing="40">
                <Label Text="Acesso&#10;para funcionários."
                       HeightRequest="118"
                       FontFamily="Inter"
                       FontAttributes="Bold"
                       FontSize="52"
                       LineHeight="1.13"
                       CharacterSpacing="-0.03"
                       TextColor="#242B28"
                       LineBreakMode="WordWrap"
                       SemanticProperties.HeadingLevel="Level1" />

                <VerticalStackLayout Spacing="28">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Login"
                               FontFamily="Inter"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#242B28" />
                        <Border HeightRequest="64"
                                Padding="16,0"
                                BackgroundColor="White"
                                Stroke="#D7DBD2"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8">
                            <Entry x:Name="LoginEntry"
                                   Placeholder="Digite seu login"
                                   FontFamily="Inter"
                                   FontSize="16"
                                   TextColor="#242B28"
                                   PlaceholderColor="#9A9E96"
                                   ReturnType="Next"
                                   SemanticProperties.Description="Login" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Senha"
                               FontFamily="Inter"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#242B28" />
                        <Border HeightRequest="64"
                                Padding="16,0"
                                BackgroundColor="White"
                                Stroke="#D7DBD2"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="*,76"
                                  VerticalOptions="Center">
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="0"
                                       Placeholder="Digite sua senha"
                                       FontFamily="Inter"
                                       FontSize="16"
                                       TextColor="#242B28"
                                       PlaceholderColor="#9A9E96"
                                       IsPassword="True"
                                       ReturnType="Go"
                                       Completed="OnPasswordCompleted"
                                       SemanticProperties.Description="Senha" />
                                <Grid Grid.Column="1"
                                      WidthRequest="44"
                                      HeightRequest="44">
                                    <Button x:Name="PasswordVisibilityButton"
                                            Text="Mostrar"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            Padding="0"
                                            FontFamily="Inter"
                                            FontAttributes="Bold"
                                            FontSize="10"
                                            TextColor="#293F35"
                                            Clicked="OnTogglePasswordVisibility"
                                            SemanticProperties.Description="Mostrar senha" />
                                </Grid>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Grid HeightRequest="64">
                        <Button x:Name="AcessButton"
                                Text="Acessar"
                                BackgroundColor="#293F35"
                                TextColor="#F3F4E9"
                                FontFamily="Inter"
                                FontAttributes="Bold"
                                FontSize="17"
                                ContentLayout="Left,24"
                                BorderWidth="0"
                                CornerRadius="8"
                                Clicked="OnAccessClicked"
                                SemanticProperties.Description="Acessar"
                                SemanticProperties.Hint="Valida os campos de acesso" />
                        <Image Source="arrow_right.svg"
                               WidthRequest="20"
                               HeightRequest="20"
                               Margin="0,0,24,0"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="1"
                               Margin="64,0,0,40"
                               Spacing="6"
                               VerticalOptions="Start"
                               SemanticProperties.Description="Idioma: Português do Brasil">
            <Image Source="globe.svg"
                   WidthRequest="14"
                   HeightRequest="14"
                   VerticalOptions="Center" />
            <Label Text="Português (BR)"
                   FontFamily="Inter"
                   FontSize="11"
                   TextColor="#727871"
                   VerticalTextAlignment="Center" />
            <Image Source="chevron_down.svg"
                   WidthRequest="12"
                   HeightRequest="12"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
