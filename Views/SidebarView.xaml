<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="lojavendas.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="RootView">
    <Grid BackgroundColor="#293F35"
          RowDefinitions="*,Auto"
          WidthRequest="240">
        <!-- Parte de cima rola quando a tela é baixa (celular deitado, janela pequena no PC). -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="14,24,14,12" Spacing="4">
                <HorizontalStackLayout Margin="14,0,0,0" Spacing="10">
                    <Image Source="nav_brand.svg"
                           WidthRequest="18"
                           HeightRequest="18"
                           VerticalOptions="Center" />
                    <Label Text="acesso"
                           FontFamily="Inter"
                           FontSize="18"
                           TextColor="White"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Label Text="GESTÃO INTERNA"
                       Margin="0,28,0,8"
                       FontFamily="Inter"
                       FontSize="11"
                       CharacterSpacing="1.5"
                       TextColor="#B8C4B8" />

                <Grid x:Name="SalesNav" HeightRequest="46">
                    <Border x:Name="SalesBackground" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 6">
                        <HorizontalStackLayout Margin="12,0" Spacing="12">
                            <Image x:Name="SalesIcon" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label x:Name="SalesLabel" Text="Vendas" FontFamily="Inter" FontSize="14" TextColor="#F3F4E9" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSalesClicked" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid x:Name="CheckoutNav" HeightRequest="40">
                    <Border x:Name="CheckoutBackground" Margin="30,0,0,0" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 6">
                        <Label x:Name="CheckoutLabel" Margin="12,0" Text="Caixa" FontFamily="Inter" FontSize="13" TextColor="#D7DBD2" VerticalTextAlignment="Center" />
                    </Border>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCheckoutClicked" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid x:Name="DebtorsNav" HeightRequest="40">
                    <Border x:Name="DebtorsBackground" Margin="30,0,0,0" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 6">
                        <Label x:Name="DebtorsLabel" Margin="12,0" Text="Devedores" FontFamily="Inter" FontSize="13" TextColor="#D7DBD2" VerticalTextAlignment="Center" />
                    </Border>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDebtorsClicked" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid x:Name="ProductsNav" HeightRequest="46">
                    <Border x:Name="ProductsBackground" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 6">
                        <HorizontalStackLayout Margin="12,0" Spacing="12">
                            <Image x:Name="ProductsIcon" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label x:Name="ProductsLabel" Text="Produtos" FontFamily="Inter" FontSize="14" TextColor="#F3F4E9" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProductsClicked" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid x:Name="EmployeesNav" HeightRequest="46">
                    <Border x:Name="EmployeesBackground" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 6">
                        <HorizontalStackLayout Margin="12,0" Spacing="12">
                            <Image x:Name="EmployeesIcon" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label x:Name="EmployeesLabel" Text="Funcionários" FontFamily="Inter" FontSize="14" TextColor="#F3F4E9" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEmployeesClicked" />
                    </Grid.GestureRecognizers>
                </Grid>

                <Grid x:Name="AnalyticsNav" HeightRequest="46">
                    <Border x:Name="AnalyticsBackground" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 6">
                        <HorizontalStackLayout Margin="12,0" Spacing="12">
                            <Image x:Name="AnalyticsIcon" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label x:Name="AnalyticsLabel" Text="Análise de vendas" FontFamily="Inter" FontSize="14" TextColor="#F3F4E9" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAnalyticsClicked" />
                    </Grid.GestureRecognizers>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="14,8,14,18" Spacing="14">
            <Border Padding="12"
                    Stroke="#52675E"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStoreNameClicked" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="8">
                        <Image Source="nav_store.svg" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                        <Label x:Name="StoreNameLabel"
                               Text="Loja Centro"
                               FontFamily="Inter"
                               FontSize="13"
                               TextColor="#F3F4E9"
                               LineBreakMode="TailTruncation"
                               MaximumWidthRequest="170"
                               VerticalTextAlignment="Center"
                               SemanticProperties.Description="Alterar nome da loja" />
                    </HorizontalStackLayout>
                    <Label Text="Toque para renomear a loja"
                           FontFamily="Inter"
                           FontSize="11"
                           TextColor="#B8C4B8" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Margin="8,0,0,0" Spacing="8">
                <Image Source="nav_help.svg" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                <Label Text="Central de ajuda"
                       FontFamily="Inter"
                       FontSize="12"
                       TextColor="#D7DBD2"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentView>
