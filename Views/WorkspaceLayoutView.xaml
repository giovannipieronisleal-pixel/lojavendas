<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="lojavendas.Views.WorkspaceLayoutView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:lojavendas.Views"
    x:Name="RootView">
    <Grid x:Name="LayoutGrid"
          ColumnDefinitions="240,*"
          BackgroundColor="#F6F5F0"
          SizeChanged="OnLayoutSizeChanged">
        <!-- Barra lateral fixa (telas largas) -->
        <views:SidebarView x:Name="Sidebar" Grid.Column="0" />

        <Grid x:Name="ContentGrid" Grid.Column="1" RowDefinitions="68,*">
            <Grid x:Name="HeaderGrid"
                  Grid.Row="0"
                  Padding="20,0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  BackgroundColor="#F6F5F0">
                <Button x:Name="MobileNavButton"
                        Grid.Column="0"
                        Text="☰"
                        FontSize="22"
                        TextColor="#293F35"
                        BackgroundColor="Transparent"
                        Padding="8,4"
                        MinimumWidthRequest="44"
                        MinimumHeightRequest="44"
                        IsVisible="False"
                        Clicked="OnMobileNavigationClicked"
                        SemanticProperties.Description="Abrir navegação" />
                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="10"
                                       VerticalOptions="Center">
                    <Label x:Name="AreaLabel"
                           Text="Área interna"
                           FontFamily="Inter"
                           FontSize="12"
                           TextColor="#727871"
                           VerticalTextAlignment="Center" />
                    <Label x:Name="BreadcrumbSeparator"
                           Text="/"
                           FontFamily="Inter"
                           FontSize="12"
                           TextColor="#9A9E96"
                           VerticalTextAlignment="Center" />
                    <Label x:Name="BreadcrumbLabel"
                           FontFamily="Inter"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#242B28"
                           LineBreakMode="TailTruncation"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
                <Grid x:Name="ProfileGrid"
                      Grid.Column="2"
                      ColumnDefinitions="36,Auto"
                      ColumnSpacing="10"
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileClicked" />
                    </Grid.GestureRecognizers>
                    <Border WidthRequest="36"
                            HeightRequest="36"
                            BackgroundColor="#EBEFE6"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">
                        <Label x:Name="ProfileInitialsLabel"
                               Text="?"
                               FontFamily="Inter"
                               FontAttributes="Bold"
                               FontSize="11"
                               TextColor="#293F35"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout x:Name="ProfileDetails"
                                         Grid.Column="1"
                                         Spacing="1"
                                         VerticalOptions="Center">
                        <Label x:Name="ProfileNameLabel"
                               Text="Usuário"
                               FontFamily="Inter"
                               FontSize="12"
                               TextColor="#242B28" />
                        <Label x:Name="ProfileRoleLabel"
                               Text="Funcionário"
                               FontFamily="Inter"
                               FontSize="10"
                               TextColor="#727871" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
            <BoxView Grid.Row="0"
                     HeightRequest="1"
                     VerticalOptions="End"
                     Color="#D7DBD2" />

            <!--
                HorizontalOptions="Fill" evita que o conteúdo encolha para a largura mínima no PC e no Android.
                O limite de 1440px continua valendo em monitores muito largos.
            -->
            <ScrollView Grid.Row="1" HorizontalScrollBarVisibility="Never">
                <ContentView x:Name="BodyHost"
                             Padding="24,20"
                             HorizontalOptions="Fill"
                             MaximumWidthRequest="1440" />
            </ScrollView>
        </Grid>

        <!-- Gaveta lateral para celular / telas estreitas -->
        <Grid x:Name="MobileDrawerOverlay"
              Grid.ColumnSpan="2"
              ColumnDefinitions="240,*"
              IsVisible="False"
              ZIndex="20">
            <views:SidebarView x:Name="MobileSidebar" Grid.Column="0" />
            <BoxView Grid.Column="1" Color="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDrawerBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
        </Grid>
    </Grid>
</ContentView>
