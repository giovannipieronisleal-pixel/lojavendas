<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="lojavendas.Pages.EmployeesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:lojavendas.Models"
    xmlns:views="clr-namespace:lojavendas.Views"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <views:WorkspaceLayoutView ActiveRoute="employees" Breadcrumb="Funcionários">
        <views:WorkspaceLayoutView.Body>
            <VerticalStackLayout Spacing="20">
                <views:ResponsiveGrid MaximumColumns="2" MinimumColumnWidth="240" ColumnSpacing="12" RowSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Funcionários" FontFamily="Inter" FontSize="26" TextColor="#242B28" />
                        <Label Text="Gerencie acessos, cargos, equipes e status." FontFamily="Inter" FontSize="13" TextColor="#727871" />
                    </VerticalStackLayout>
                    <Button Text="＋  Criar funcionário"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            BackgroundColor="#293F35"
                            TextColor="White"
                            FontFamily="Inter"
                            FontSize="13"
                            Padding="16,10"
                            Clicked="OnNewEmployeeClicked" />
                </views:ResponsiveGrid>

                <views:ResponsiveGrid MaximumColumns="3" MinimumColumnWidth="230" ColumnSpacing="12" RowSpacing="12">
                    <Border Padding="18" BackgroundColor="#293F35" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Total de funcionários" FontFamily="Inter" FontSize="11" TextColor="#D7DBD2" />
                            <Label x:Name="TotalCountLabel" Text="0" FontFamily="Inter" FontSize="24" TextColor="White" />
                            <Label Text="Contas cadastradas" FontFamily="Inter" FontSize="10" TextColor="#D4E6B0" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="18" BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ativos" FontFamily="Inter" FontSize="11" TextColor="#727871" />
                            <Label x:Name="ActiveCountLabel" Text="0" FontFamily="Inter" FontSize="24" TextColor="#242B28" />
                            <Label Text="Podem entrar no sistema" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="18" BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Inativos" FontFamily="Inter" FontSize="11" TextColor="#727871" />
                            <Label x:Name="InactiveCountLabel" Text="0" FontFamily="Inter" FontSize="24" TextColor="#242B28" />
                            <Label Text="Acesso suspenso" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                        </VerticalStackLayout>
                    </Border>
                </views:ResponsiveGrid>

                <Border BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                            <Label Text="Equipe de funcionários" FontFamily="Inter" FontSize="13" FontAttributes="Bold" TextColor="#293F35" />
                            <Label x:Name="ListCountLabel" Grid.Column="1" Text="0 funcionários" FontFamily="Inter" FontSize="10" TextColor="#727871" VerticalTextAlignment="Center" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Employees}"
                                             BindableLayout.EmptyView="Nenhum funcionário cadastrado."
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:EmployeeRecord">
                                    <Grid Padding="16,12" RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontFamily="Inter" FontSize="15" TextColor="#242B28" />
                                                <Label Text="{Binding Username}" FontFamily="Inter" FontSize="12" TextColor="#727871" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1"
                                                    Text="•••"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#293F35"
                                                    FontFamily="Inter"
                                                    FontSize="16"
                                                    Padding="12,6"
                                                    Clicked="OnEditEmployeeClicked"
                                                    SemanticProperties.Description="Editar funcionário" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Cargo" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                                                <Label Text="{Binding Role}" FontFamily="Inter" FontSize="12" TextColor="#242B28" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="Equipe" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                                                <Label Text="{Binding Team}" FontFamily="Inter" FontSize="12" TextColor="#242B28" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                <Label Text="Status" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                                                <Label Text="{Binding StatusText}" FontFamily="Inter" FontSize="12" TextColor="#416349" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Label Text="As permissões das abas são determinadas pelo cargo do funcionário."
                       FontFamily="Inter" FontSize="10" TextColor="#727871" />
            </VerticalStackLayout>
        </views:WorkspaceLayoutView.Body>
    </views:WorkspaceLayoutView>
</ContentPage>
