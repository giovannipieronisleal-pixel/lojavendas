<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="lojavendas.Pages.DebtorsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:lojavendas.Models"
    xmlns:views="clr-namespace:lojavendas.Views"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <views:WorkspaceLayoutView ActiveRoute="debts" Breadcrumb="Devedores">
        <views:WorkspaceLayoutView.Body>
            <VerticalStackLayout Spacing="18">
                <views:ResponsiveGrid MaximumColumns="2" MinimumColumnWidth="240" ColumnSpacing="12" RowSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="‹  Voltar para vendas" HorizontalOptions="Start" BackgroundColor="Transparent" TextColor="#727871" FontFamily="Inter" FontSize="13" Padding="0,4" Clicked="OnBackToSalesClicked" />
                        <Label Text="Devedores" FontFamily="Inter" FontSize="26" TextColor="#242B28" />
                    </VerticalStackLayout>
                    <Button Text="＋ Nova venda"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            BackgroundColor="#293F35"
                            TextColor="White"
                            FontFamily="Inter"
                            FontSize="13"
                            Padding="14,10"
                            Clicked="OnCheckoutClicked" />
                </views:ResponsiveGrid>

                <Border Padding="18" BackgroundColor="#293F35" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Total a receber" FontFamily="Inter" FontSize="13" TextColor="#D7DBD2" />
                        <Label x:Name="OutstandingTotalLabel" Text="R$ 0,00" FontFamily="Inter" FontSize="28" TextColor="White" />
                        <Label x:Name="OutstandingCountLabel" Text="0 clientes com saldo em aberto" FontFamily="Inter" FontSize="12" TextColor="#D4E6B0" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16,16,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label x:Name="DebtListTitle" Text="Clientes  0" FontFamily="Inter" FontSize="16" FontAttributes="Bold" TextColor="#242B28" VerticalTextAlignment="Center" />
                            <Button x:Name="ShowPaidToggle" Grid.Column="1" Text="Mostrar quitados" BackgroundColor="White" TextColor="#293F35" BorderColor="#D7DBD2" BorderWidth="1" FontFamily="Inter" FontSize="12" Padding="10,6" Clicked="OnShowPaidToggleClicked" />
                        </Grid>
                        <Entry x:Name="CustomerSearchEntry" Margin="16,0,16,8" Placeholder="Buscar cliente pelo nome" FontFamily="Inter" FontSize="14" TextColor="#242B28" PlaceholderColor="#727871" BackgroundColor="#F6F5F0" TextChanged="OnCustomerSearchTextChanged" />
                        <VerticalStackLayout x:Name="EmptyStateLayout" Padding="24" Spacing="8" HorizontalOptions="Center" IsVisible="False">
                            <Label Text="Nenhum cliente encontrado" FontFamily="Inter" FontSize="15" TextColor="#242B28" HorizontalTextAlignment="Center" />
                            <Label Text="As vendas a prazo ficam agrupadas aqui pelo nome do cliente." FontFamily="Inter" FontSize="13" TextColor="#727871" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Customers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerAccount">
                                    <VerticalStackLayout Padding="16,14" Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Name}" FontFamily="Inter" FontSize="16" FontAttributes="Bold" TextColor="#242B28" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding SummaryText}" FontFamily="Inter" FontSize="13" TextColor="#727871" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding StatusText}" FontFamily="Inter" FontSize="13" TextColor="{Binding StatusColor}" VerticalTextAlignment="Start" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="Saldo devedor" FontFamily="Inter" FontSize="12" TextColor="#727871" />
                                                <Label Text="{Binding OutstandingText}" FontFamily="Inter" FontSize="17" FontAttributes="Bold" TextColor="#242B28" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label Text="Última compra" FontFamily="Inter" FontSize="12" TextColor="#727871" />
                                                <Label Text="{Binding LastPurchaseText}" FontFamily="Inter" FontSize="14" TextColor="#242B28" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Text="Receber"
                                                    BackgroundColor="#293F35"
                                                    TextColor="White"
                                                    FontFamily="Inter"
                                                    FontSize="13"
                                                    Padding="12,10"
                                                    IsEnabled="{Binding CanReceivePayment}"
                                                    Clicked="OnReceiveFromCustomerClicked" />
                                            <Button Grid.Column="1"
                                                    Text="{Binding ToggleText}"
                                                    BackgroundColor="White"
                                                    TextColor="#293F35"
                                                    BorderColor="#D7DBD2"
                                                    BorderWidth="1"
                                                    FontFamily="Inter"
                                                    FontSize="13"
                                                    Padding="12,10"
                                                    Clicked="OnToggleSalesClicked" />
                                        </Grid>
                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="0" BindableLayout.ItemsSource="{Binding Sales}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:SaleRecord">
                                                    <Border Margin="0,0,0,8" Padding="12" BackgroundColor="#F6F5F0" Stroke="#E4E6DF" StrokeShape="RoundRectangle 8">
                                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                                            <VerticalStackLayout Spacing="2">
                                                                <Label Text="{Binding SaleNumber}" FontFamily="Inter" FontSize="14" FontAttributes="Bold" TextColor="#293F35" />
                                                                <Label Text="{Binding CreatedAtText}" FontFamily="Inter" FontSize="12" TextColor="#727871" />
                                                                <Label Text="{Binding SellerName, StringFormat='Atendente: {0}'}" FontFamily="Inter" FontSize="12" TextColor="#727871" />
                                                            </VerticalStackLayout>
                                                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                                                <Label Text="{Binding TotalText, StringFormat='Total: {0}'}" FontFamily="Inter" FontSize="12" TextColor="#242B28" HorizontalTextAlignment="End" />
                                                                <Label Text="{Binding OutstandingText, StringFormat='Em aberto: {0}'}" FontFamily="Inter" FontSize="13" FontAttributes="Bold" TextColor="#242B28" HorizontalTextAlignment="End" />
                                                                <Label Text="{Binding Status}" FontFamily="Inter" FontSize="12" TextColor="#A97528" HorizontalTextAlignment="End" />
                                                            </VerticalStackLayout>
                                                            <Button Grid.Row="1" Grid.ColumnSpan="2"
                                                                    Text="Comprovantes"
                                                                    BackgroundColor="White"
                                                                    TextColor="#293F35"
                                                                    BorderColor="#D7DBD2"
                                                                    BorderWidth="1"
                                                                    FontFamily="Inter"
                                                                    FontSize="12"
                                                                    Padding="10,8"
                                                                    Clicked="OnPaymentReceiptsClicked" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <BoxView HeightRequest="1" Color="#E4E6DF" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </views:WorkspaceLayoutView.Body>
    </views:WorkspaceLayoutView>
</ContentPage>
