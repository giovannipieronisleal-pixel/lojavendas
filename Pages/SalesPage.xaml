<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="lojavendas.Pages.SalesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:lojavendas.Models"
    xmlns:views="clr-namespace:lojavendas.Views"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <views:WorkspaceLayoutView ActiveRoute="sales" Breadcrumb="Vendas">
        <views:WorkspaceLayoutView.Body>
            <VerticalStackLayout Spacing="20">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Vendas" FontFamily="Inter" FontSize="28" TextColor="#242B28" />
                        <Label Text="Acompanhe as vendas registradas no caixa." FontFamily="Inter" FontSize="12" TextColor="#727871" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Devedores" BackgroundColor="White" TextColor="#293F35" BorderColor="#D7DBD2" BorderWidth="1" FontFamily="Inter" FontSize="13" Padding="12,9" Clicked="OnDebtorsClicked" />
                        <Button Text="＋  Registrar venda" BackgroundColor="#293F35" TextColor="White" FontFamily="Inter" FontSize="13" Padding="12,9" Clicked="OnRegisterSaleClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
                <views:ResponsiveGrid MaximumColumns="3" MinimumColumnWidth="230" ColumnSpacing="12" RowSpacing="12">
                    <Border Padding="18" BackgroundColor="#293F35" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Receita recebida" FontFamily="Inter" FontSize="11" TextColor="#D7DBD2" />
                            <Label x:Name="RevenueLabel" Text="R$ 0,00" FontFamily="Inter" FontSize="23" TextColor="White" />
                            <Label Text="Vendas concluídas" FontFamily="Inter" FontSize="10" TextColor="#D4E6B0" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="18" BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Vendas concluídas" FontFamily="Inter" FontSize="11" TextColor="#727871" />
                            <Label x:Name="CompletedCountLabel" Text="0" FontFamily="Inter" FontSize="23" TextColor="#242B28" />
                            <Label Text="Pagamentos finalizados" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="18" BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="A receber" FontFamily="Inter" FontSize="11" TextColor="#727871" />
                            <Label x:Name="PendingTotalLabel" Text="R$ 0,00" FontFamily="Inter" FontSize="23" TextColor="#242B28" />
                            <Label x:Name="PendingCountLabel" Text="0 vendas pendentes" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                        </VerticalStackLayout>
                    </Border>
                </views:ResponsiveGrid>
                <Border BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="0">
                        <Label x:Name="SalesListTitle" Text="Vendas registradas  0" Padding="18,16" FontFamily="Inter" FontSize="12" FontAttributes="Bold" TextColor="#293F35" />
                        <CollectionView ItemsSource="{Binding Sales}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="Nenhuma venda registrada. Inicie uma venda pelo botão acima." Padding="24" FontFamily="Inter" FontSize="11" TextColor="#727871" HorizontalTextAlignment="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SaleRecord">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="16,12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding SaleNumber}" FontFamily="Inter" FontSize="14" TextColor="#293F35" />
                                                <Label Text="{Binding CreatedAtText}" FontFamily="Inter" FontSize="12" TextColor="#727871" />
                                            </VerticalStackLayout>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding CustomerDisplay}" FontFamily="Inter" FontSize="13" TextColor="#242B28" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding TotalText}" FontFamily="Inter" FontSize="13" TextColor="#242B28" VerticalTextAlignment="Center" />
                                            </Grid>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Label Text="{Binding SellerName}" FontFamily="Inter" FontSize="12" TextColor="#727871" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding PaymentMethod}" FontFamily="Inter" FontSize="12" TextColor="#727871" VerticalTextAlignment="Center" />
                                            </Grid>
                                            <Label Grid.Row="3" Text="{Binding Status}" FontFamily="Inter" FontSize="12" TextColor="#416349" HorizontalTextAlignment="End" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#E4E6DF" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </views:WorkspaceLayoutView.Body>
    </views:WorkspaceLayoutView>
</ContentPage>
