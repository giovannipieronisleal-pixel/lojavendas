<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="lojavendas.Pages.SalesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:lojavendas.Models"
    xmlns:views="clr-namespace:lojavendas.Views"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <views:WorkspaceLayoutView ActiveRoute="sales" Breadcrumb="Vendas">
        <views:WorkspaceLayoutView.Body>
            <VerticalStackLayout Spacing="18">
                <views:ResponsiveGrid MaximumColumns="2" MinimumColumnWidth="260" ColumnSpacing="12" RowSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Vendas" FontFamily="Inter" FontSize="26" TextColor="#242B28" />
                        <Label Text="Acompanhe as vendas registradas no caixa." FontFamily="Inter" FontSize="13" TextColor="#727871" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Button Text="Devedores" BackgroundColor="White" TextColor="#293F35" BorderColor="#D7DBD2" BorderWidth="1" FontFamily="Inter" FontSize="13" Padding="12,10" Clicked="OnDebtorsClicked" />
                        <Button Grid.Column="1" Text="＋  Registrar venda" BackgroundColor="#293F35" TextColor="White" FontFamily="Inter" FontSize="13" Padding="12,10" Clicked="OnRegisterSaleClicked" />
                    </Grid>
                </views:ResponsiveGrid>

                <views:ResponsiveGrid MaximumColumns="3" MinimumColumnWidth="200" ColumnSpacing="12" RowSpacing="12">
                    <Border Padding="16" BackgroundColor="#293F35" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Receita recebida" FontFamily="Inter" FontSize="12" TextColor="#D7DBD2" />
                            <Label x:Name="RevenueLabel" Text="R$ 0,00" FontFamily="Inter" FontSize="23" TextColor="White" />
                            <Label Text="Vendas concluídas" FontFamily="Inter" FontSize="11" TextColor="#D4E6B0" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="16" BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Vendas concluídas" FontFamily="Inter" FontSize="12" TextColor="#727871" />
                            <Label x:Name="CompletedCountLabel" Text="0" FontFamily="Inter" FontSize="23" TextColor="#242B28" />
                            <Label Text="Pagamentos finalizados" FontFamily="Inter" FontSize="11" TextColor="#727871" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="16" BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="A receber" FontFamily="Inter" FontSize="12" TextColor="#727871" />
                            <Label x:Name="PendingTotalLabel" Text="R$ 0,00" FontFamily="Inter" FontSize="23" TextColor="#242B28" />
                            <Label x:Name="PendingCountLabel" Text="0 vendas pendentes" FontFamily="Inter" FontSize="11" TextColor="#727871" />
                        </VerticalStackLayout>
                    </Border>
                </views:ResponsiveGrid>

                <Border BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="0">
                        <Label x:Name="SalesListTitle" Text="Vendas registradas  0" Padding="16,16" FontFamily="Inter" FontSize="14" FontAttributes="Bold" TextColor="#293F35" />
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding Sales}"
                                             BindableLayout.EmptyView="Nenhuma venda registrada. Inicie uma venda pelo botão acima.">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SaleRecord">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="16,12" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding SaleNumber}" FontFamily="Inter" FontSize="14" FontAttributes="Bold" TextColor="#293F35" />
                                                    <Label Text="{Binding CreatedAtText}" FontFamily="Inter" FontSize="12" TextColor="#727871" VerticalTextAlignment="Center" />
                                                </HorizontalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Status}" FontFamily="Inter" FontSize="12" TextColor="#416349" VerticalTextAlignment="Center" />
                                            </Grid>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding CustomerDisplay}" FontFamily="Inter" FontSize="14" TextColor="#242B28" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1" Text="{Binding TotalText}" FontFamily="Inter" FontSize="15" FontAttributes="Bold" TextColor="#242B28" VerticalTextAlignment="Center" />
                                            </Grid>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding SellerName, StringFormat='Atendente: {0}'}" FontFamily="Inter" FontSize="12" TextColor="#727871" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1" Text="{Binding PaymentMethod}" FontFamily="Inter" FontSize="12" TextColor="#727871" VerticalTextAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#E4E6DF" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </views:WorkspaceLayoutView.Body>
    </views:WorkspaceLayoutView>
</ContentPage>
