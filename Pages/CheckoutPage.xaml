<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="lojavendas.Pages.CheckoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:lojavendas.Models"
    xmlns:pages="clr-namespace:lojavendas.Pages"
    xmlns:views="clr-namespace:lojavendas.Views"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <views:WorkspaceLayoutView ActiveRoute="checkout" Breadcrumb="Vendas">
        <views:WorkspaceLayoutView.Body>
            <VerticalStackLayout Spacing="16">
                <Button x:Name="BackToSalesButton"
                        Text="‹  Voltar para vendas"
                        HorizontalOptions="Start"
                        BackgroundColor="Transparent"
                        TextColor="#727871"
                        FontFamily="Inter"
                        FontSize="11"
                        Padding="0"
                        Clicked="OnBackToSalesClicked" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Caixa aberto" FontFamily="Inter" FontSize="28" TextColor="#242B28" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                        <Label Text="● Caixa aberto" FontFamily="Inter" FontSize="10" TextColor="#416349" HorizontalTextAlignment="End" />
                        <Label x:Name="SellerLabel" Text="Venda local" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                    </VerticalStackLayout>
                </Grid>
                <HorizontalStackLayout Spacing="20" Padding="4,0,0,12">
                    <Button Text="🛒  Caixa" BackgroundColor="Transparent" TextColor="#293F35" FontFamily="Inter" FontSize="12" Padding="0,6" />
                    <Button x:Name="DebtorsTabButton" Text="◷  Devedores" BackgroundColor="Transparent" TextColor="#727871" FontFamily="Inter" FontSize="12" Padding="0,6" Clicked="OnDebtorsClicked" />
                </HorizontalStackLayout>
                <views:ResponsiveGrid MaximumColumns="2" MinimumColumnWidth="360" ColumnSpacing="16" RowSpacing="14">
                    <VerticalStackLayout Spacing="14">
                        <Border Padding="18" BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Adicionar produto" FontFamily="Inter" FontSize="14" TextColor="#242B28" />
                                <Label Text="Código de barras ou nome do produto" FontFamily="Inter" FontSize="10" TextColor="#242B28" />
                                <Border HeightRequest="50"
                                        Padding="14,0"
                                        BackgroundColor="White"
                                        Stroke="#D7DBD2"
                                        StrokeShape="RoundRectangle 8">
                                    <Grid ColumnDefinitions="28,*,40" ColumnSpacing="8">
                                        <Image Source="icon_barcode.svg"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               VerticalOptions="Center" />
                                        <Entry x:Name="ProductSearchEntry"
                                               Grid.Column="1"
                                               Placeholder="Leia o código ou digite o produto"
                                               FontFamily="Inter"
                                               FontSize="12"
                                               TextColor="#242B28"
                                               PlaceholderColor="#727871"
                                               ReturnType="Search"
                                               TextChanged="OnProductSearchTextChanged"
                                               Completed="OnProductSearchCompleted" />
                                        <Button Grid.Column="2"
                                                Text="⌕"
                                                FontSize="20"
                                                BackgroundColor="Transparent"
                                                TextColor="#293F35"
                                                Padding="0"
                                                Clicked="OnProductSearchClicked"
                                                SemanticProperties.Description="Pesquisar produtos" />
                                    </Grid>
                                </Border>
                                <CollectionView x:Name="ProductSearchResults"
                                                ItemsSource="{Binding SearchResults}"
                                                SelectionMode="Single"
                                                SelectionChanged="OnProductSelected"
                                                HeightRequest="160"
                                                IsVisible="False">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProductRecord">
                                            <Grid Padding="12,8" ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding Name}" FontFamily="Inter" FontSize="11" TextColor="#242B28" />
                                                    <Label Text="{Binding Code}" FontFamily="Inter" FontSize="9" TextColor="#727871" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                                    <Label Text="{Binding PriceText}" FontFamily="Inter" FontSize="10" TextColor="#242B28" HorizontalTextAlignment="End" />
                                                    <Label Text="{Binding StockText}" FontFamily="Inter" FontSize="9" TextColor="#727871" HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Label x:Name="NoProductsFoundLabel"
                                       Text="Nenhum produto encontrado no catálogo."
                                       IsVisible="False"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       TextColor="#727871" />
                                <Grid ColumnDefinitions="160,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Quantidade" FontFamily="Inter" FontSize="10" TextColor="#242B28" />
                                        <Border HeightRequest="44"
                                                Padding="4,0"
                                                BackgroundColor="White"
                                                Stroke="#D7DBD2"
                                                StrokeShape="RoundRectangle 8">
                                            <Grid ColumnDefinitions="44,*,44">
                                                <Button Text="−"
                                                        FontSize="20"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#293F35"
                                                        Padding="0"
                                                        Clicked="OnDecreaseQuantityClicked"
                                                        SemanticProperties.Description="Diminuir quantidade" />
                                                <Label x:Name="QuantityLabel"
                                                       Grid.Column="1"
                                                       Text="1"
                                                       FontFamily="Inter"
                                                       FontSize="12"
                                                       TextColor="#242B28"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Text="+"
                                                        FontSize="18"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#293F35"
                                                        Padding="0"
                                                        Clicked="OnIncreaseQuantityClicked"
                                                        SemanticProperties.Description="Aumentar quantidade" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="＋   Adicionar"
                                            VerticalOptions="End"
                                            HeightRequest="44"
                                            BackgroundColor="#293F35"
                                            TextColor="White"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            Clicked="OnAddProductClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="0">
                                <Grid Padding="18,16" ColumnDefinitions="*,Auto">
                                    <Label Text="Itens da venda" FontFamily="Inter" FontSize="14" TextColor="#242B28" />
                                    <Label x:Name="CartCountLabel" Grid.Column="1" Text="0 itens" FontFamily="Inter" FontSize="10" TextColor="#727871" VerticalTextAlignment="Center" />
                                </Grid>
                                <CollectionView ItemsSource="{Binding Cart}" SelectionMode="None">
                                    <CollectionView.EmptyView>
                                        <Label Text="Adicione produtos para iniciar a venda." Padding="20" FontFamily="Inter" FontSize="10" TextColor="#727871" HorizontalTextAlignment="Center" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="pages:CartLine">
                                            <Grid Padding="18,12" ColumnDefinitions="2*,Auto,Auto,Auto" ColumnSpacing="12">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Product.Name}" FontFamily="Inter" FontSize="11" TextColor="#242B28" />
                                                    <Label Text="{Binding Product.Code}" FontFamily="Inter" FontSize="9" TextColor="#727871" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Quantity}" FontFamily="Inter" FontSize="10" TextColor="#242B28" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="2" Text="{Binding SubtotalText}" FontFamily="Inter" FontSize="10" TextColor="#242B28" VerticalTextAlignment="Center" />
                                                <Button Grid.Column="3" Text="Remover" BackgroundColor="Transparent" TextColor="#B84F42" FontSize="9" Padding="4" Clicked="OnRemoveItemClicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Border BackgroundColor="White" Stroke="#D7DBD2" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout Padding="18" Spacing="12">
                                <Label Text="Pagamento" FontFamily="Inter" FontSize="14" TextColor="#242B28" />
                                <Label Text="Forma de pagamento" FontFamily="Inter" FontSize="10" TextColor="#242B28" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="48,48" ColumnSpacing="8" RowSpacing="8">
                                    <Button x:Name="CashPaymentButton"
                                            Text="▣  Dinheiro"
                                            BackgroundColor="#EBEFE6"
                                            TextColor="#293F35"
                                            BorderColor="#52675E"
                                            BorderWidth="1"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            Clicked="OnCashPaymentClicked" />
                                    <Button x:Name="PixPaymentButton"
                                            Grid.Column="1"
                                            Text="▦  Pix"
                                            BackgroundColor="White"
                                            TextColor="#242B28"
                                            BorderColor="#D7DBD2"
                                            BorderWidth="1"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            Clicked="OnPixPaymentClicked" />
                                    <Button x:Name="CardPaymentButton"
                                            Grid.Row="1"
                                            Text="▭  Cartão"
                                            BackgroundColor="White"
                                            TextColor="#242B28"
                                            BorderColor="#D7DBD2"
                                            BorderWidth="1"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            Clicked="OnCardPaymentClicked" />
                                    <Button x:Name="PayLaterButton"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="◷  Devedor"
                                            BackgroundColor="White"
                                            TextColor="#242B28"
                                            BorderColor="#D7DBD2"
                                            BorderWidth="1"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            Clicked="OnPayLaterClicked" />
                                </Grid>
                                <Label x:Name="SelectedPaymentLabel"
                                       Text="Forma selecionada: Dinheiro"
                                       FontFamily="Inter"
                                       FontSize="9"
                                       TextColor="#727871" />
                                <VerticalStackLayout x:Name="CashPaymentPanel" Spacing="6">
                                    <Label Text="Total pago / recebido (R$)" FontFamily="Inter" FontSize="10" TextColor="#242B28" />
                                    <Entry x:Name="AmountReceivedEntry" Placeholder="Ex.: 100,00" Keyboard="Text"
                                           TextChanged="OnAmountReceivedChanged" TextColor="#242B28" PlaceholderColor="#727871" BackgroundColor="White" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Troco" FontFamily="Inter" FontSize="12" TextColor="#242B28" />
                                        <Label x:Name="ChangeLabel" Grid.Column="1" Text="R$ 0,00" FontFamily="Inter" FontSize="12" FontAttributes="Bold" TextColor="#293F35" />
                                    </Grid>
                                </VerticalStackLayout>
                                <Label x:Name="PayLaterHint" Text="Ao concluir, informe o nome do devedor para registrar a venda pendente." IsVisible="False" FontFamily="Inter" FontSize="10" TextColor="#727871" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Margin="18,0" Color="#E4E6DF" />
                            <VerticalStackLayout Padding="18" BackgroundColor="#293F35" Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Total da venda" FontFamily="Inter" FontSize="10" TextColor="#D7DBD2" />
                                        <Label x:Name="CartSummaryLabel" Text="0 itens" FontFamily="Inter" FontSize="9" TextColor="#B8C4B8" />
                                    </VerticalStackLayout>
                                    <Label x:Name="TotalLabel" Grid.Column="1" Text="R$ 0,00" FontFamily="Inter" FontSize="22" TextColor="White" VerticalTextAlignment="Center" />
                                </Grid>
                                <Label x:Name="CheckoutErrorLabel" IsVisible="False" FontFamily="Inter" FontSize="10" TextColor="#FFD5CA" />
                                <Button Text="Concluir venda   →" BackgroundColor="#D4E6B0" TextColor="#293F35" FontFamily="Inter" FontSize="11" Clicked="OnReceiveClicked" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </views:ResponsiveGrid>
            </VerticalStackLayout>
        </views:WorkspaceLayoutView.Body>
    </views:WorkspaceLayoutView>
</ContentPage>
